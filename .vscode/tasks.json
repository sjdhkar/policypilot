{
  "version": "2.0.0",
  "tasks": [
    { "label": "build", "type": "shell", "command": "dotnet build", "group": "build", "problemMatcher": "$msCompile" },
    { "label": "tests + eval", "type": "shell", "command": "dotnet run --project src/PolicyPilot.Eval -- all", "group": "test", "problemMatcher": [] },
    { "label": "run api", "type": "shell", "command": "dotnet run --project src/PolicyPilot.Api --urls http://localhost:5080", "isBackground": true, "problemMatcher": [] },
    { "label": "run web", "type": "shell", "command": "npm start", "options": { "cwd": "${workspaceFolder}/web" }, "isBackground": true, "problemMatcher": [] }
  ]
}
